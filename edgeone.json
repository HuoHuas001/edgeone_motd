{
  "name": "edgeone-motd",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "22.11.0",
  "rewrites": [{ "source": "/*", "destination": "/index.html" }],
  "cloudFunctions": {
    "maxDuration": 60,
    "includeFiles": ["backend/**", "front/src/locales/*.json"],
    "externalNodeModules": ["express", "cors", "varint", "@edgeone/pages-blob", "@napi-rs/canvas"]
  }
}
