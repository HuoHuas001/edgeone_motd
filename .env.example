QUERY_TIMEOUT_MS=5000
# Optional public HTTP origin for absolute screenshot URLs behind a reverse proxy.
PUBLIC_ORIGIN=

# Platform-neutral storage selection. Default adapter: EdgeOne Pages Blob.
STORAGE_PROVIDER=edgeone-blob
STORAGE_NAMESPACE=mcmotd
# Set false explicitly for local MOTD/image queries without any storage credentials.
STORAGE_ENABLED=true

# Only for external/local access. On EdgeOne, deployment credentials are automatic.
EDGEONE_BLOB_PROJECT_ID=
EDGEONE_BLOB_API_TOKEN=

# Admin uses the original frontend's MD5 password contract.
ADMIN_USERNAME=
ADMIN_PASSWORD_MD5=
