# Optional: MOTD JSON and direct images work without persistent storage.
QUERY_TIMEOUT_MS=5000

# Required for persistent analytics and API cache (Turso / remote libSQL).
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Required for /api/sync_app_img and /api/screenshot/:file.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PREFIX=mcmotd/app-images/

# Admin uses the original frontend's MD5 password contract.
ADMIN_USERNAME=
ADMIN_PASSWORD_MD5=
